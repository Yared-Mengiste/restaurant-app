# --- Business Assets (Products & Categories) ---
# We ignore the uploaded files but KEEP the directory structure
/storage/app/public/products/*
/storage/app/public/categories/*

# IMPORTANT: Allow .gitignore files so Git tracks these empty folders
!/storage/app/public/products/.gitignore
!/storage/app/public/categories/.gitignore
