# --- Laravel Core ---
/.phpunit.cache
/node_modules
/public/hot
/public/build/assets/
/vendor
.env
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
/auth.json
/public/storage

# --- IDE & System ---
/.fleet
/.idea
/.nova
/.vscode
