# Ignore node_modules (installed inside Docker)
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log

# Ignore vendor (composer install runs inside Docker)
vendor/

# Laravel caches
bootstrap/cache/*.php

# Laravel logs
storage/logs/
storage/framework/sessions/
storage/framework/views/
storage/framework/cache/data/

# Local environment files
.env
.env.backup
.env.local
.env.development
.env.production
.env.testing

# IDE / Editor folders
.idea/
.vscode/
*.code-workspace

# OS Files
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# NPM & Yarn lock files (optional, if you don't want to copy them)
# package-lock.json
# yarn.lock

# Tests
phpunit.xml
phpunit.xml.dist
tests/

# Node Modules Cache
**/.pnpm-store
